<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item>
        <layer-list>
            <item>
                <color android:color="@android:color/white" />
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.0dip" android:color="@color/brown" />
                    <padding android:left="@dimen/dimen_3dp" android:top="@dimen/dimen_3dp" android:right="@dimen/dimen_3dp" android:bottom="@dimen/dimen_3dp" />
                    <corners android:radius="2.0dip" />
                </shape>
            </item>
            <item android:right="3.0dip">
                <bitmap android:gravity="center|right" android:src="@drawable/ic_down_arrow_brown" />
            </item>
        </layer-list>
    </item>
</selector>
