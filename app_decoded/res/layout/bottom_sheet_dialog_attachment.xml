<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/ym_margin_normal" android:text="@string/ym_title_choose_option" style="@style/TextAppearance.AppCompat.Body1" />
    <View android:background="@color/black_overlay" android:layout_width="fill_parent" android:layout_height="1.0dip" />
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/ym_margin_normal">
        <LinearLayout android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:id="@id/camera_layout" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_camera_ym" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ym_title_camera" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:id="@id/file_layout" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_upload_file_ym" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ym_title_file" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
