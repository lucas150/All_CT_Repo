<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/white" android:layout_width="fill_parent" android:layout_height="wrap_content" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <RelativeLayout android:layout_width="fill_parent" android:layout_height="wrap_content">
            <ImageView android:layout_width="fill_parent" android:layout_height="wrap_content" android:src="@drawable/combined_shape_6" android:scaleType="fitXY" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dimen_25dp" android:layout_centerHorizontal="true" app:srcCompat="@drawable/ic_leave_feedback_big" />
            <ImageView android:id="@id/img_close" android:layout_width="@dimen/dimen_20dp" android:layout_height="@dimen/dimen_20dp" android:layout_marginTop="@dimen/dimen_10dp" android:layout_marginRight="@dimen/dimen_15dp" android:layout_alignParentRight="true" app:srcCompat="@drawable/ic_close_white" />
        </RelativeLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/text_23sp" android:textColor="@color/black" android:gravity="center" android:id="@id/txt_feedback" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dimen_20dp" android:text="Share your suggestions" android:fontFamily="@font/pf_handbook_pro_regular" />
            <TextView android:textSize="@dimen/text_15.4sp" android:textColor="@color/black_opacity60" android:gravity="center_horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dimen_25dp" android:layout_marginTop="@dimen/dimen_8dp" android:layout_marginRight="@dimen/dimen_25dp" android:text="How can we do better? Share your suggestions below &amp; we will get back to you at the earliest." android:fontFamily="@font/pf_handbook_pro_regular" />
            <TextView android:textSize="@dimen/text_13.4sp" android:textColor="@color/cashless_claim_grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dimen_15dp" android:layout_marginTop="@dimen/dimen_17dp" android:text="Select Reason" />
            <RelativeLayout android:background="@drawable/feedback_spinner_bg" android:layout_width="@dimen/dimen_308dp" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dimen_15dp" android:layout_marginTop="@dimen/dimen_5dp" android:layout_marginRight="@dimen/dimen_15dp">
                <Spinner android:entries="@array/feedback_array" android:id="@id/spnr_feedback" android:background="@null" android:layout_width="fill_parent" android:layout_height="@dimen/dimen_50dp" />
                <ImageView android:layout_width="@dimen/dimen_50dp" android:layout_height="@dimen/dimen_50dp" android:src="@drawable/ic_spinner_dropdown" android:layout_alignParentRight="true" android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView android:textSize="@dimen/text_13.4sp" android:textColor="@color/cashless_claim_grey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dimen_15dp" android:layout_marginTop="@dimen/dimen_20dp" android:text="Your suggestion" />
            <EditText android:gravity="start" android:id="@id/edt_feedback_msg" android:background="@drawable/edt_feedback_bg" android:paddingLeft="@dimen/dimen_20dp" android:paddingTop="@dimen/dimen_10dp" android:layout_width="fill_parent" android:layout_height="@dimen/dimen_93dp" android:layout_marginLeft="@dimen/dimen_15dp" android:layout_marginTop="@dimen/dimen_8dp" android:layout_marginRight="@dimen/dimen_15dp" android:hint="Write your message here" android:inputType="text" android:imeOptions="actionGo" android:imeActionLabel="Submit" />
            <Button android:textSize="@dimen/txt_size_18sp" android:textColor="@color/white" android:gravity="center|left" android:id="@id/btn_submit" android:background="@drawable/button_bg_coolgrey" android:paddingLeft="@dimen/dimen_15dp" android:paddingRight="@dimen/dimen_10dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dimen_15dp" android:layout_marginTop="@dimen/dimen_20dp" android:layout_marginRight="@dimen/dimen_15dp" android:layout_marginBottom="@dimen/dimen_30dp" android:text="SUBMIT" android:drawableRight="@drawable/button_right_arrow_white" android:fontFamily="@font/pf_handbook_pro_regular" />
            <TextView android:textSize="@dimen/text_17.3sp" android:textColor="@color/black_opacity40" android:gravity="center_horizontal" android:layout_gravity="center_horizontal" android:id="@id/txt_cancel" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel" android:fontFamily="@font/pf_handbook_pro_regular" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
