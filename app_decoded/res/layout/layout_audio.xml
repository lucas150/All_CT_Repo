    <LinearLayout android:orientation="horizontal" android:background="#fff4f7f8" android:padding="@dimen/dimen_5dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dimen_40dp">
