<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <!-- ONLY ONE DIRECT CHILD -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Lab"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send an Event to test"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- =================== PUSH EVENT CARD =================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_box_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊  Push Event"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Name *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etEventName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_field_bg"
                android:textColor="@color/text_primary"
                android:text="Product Viewed"
                android:textColorHint="@color/input_hint"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Properties"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etEventProps"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/input_field_bg"
                android:textColor="@color/text_primary"
                android:text="{&quot;foo&quot;:&quot;xyz&quot;,&quot;lang&quot;:&quot;French&quot;}"
                android:textColorHint="@color/input_hint"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional JSON object with event properties"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="6dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnPushEvent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Push Event"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/button_bg" />
        </LinearLayout>


        <!-- =================== CHARGED EVENT CARD =================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_box_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💳  Charged Event"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSampleCharged"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Load Sample"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/button_bg" />
            </LinearLayout>

            <EditText
                android:id="@+id/etChargeDetails"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/input_field_bg"
                android:textColor="@color/text_primary"
                android:text="{&quot;Amount&quot;:300,&quot;Payment&quot;:&quot;Card&quot;}"
                android:gravity="top"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etChargeItems"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field_bg"
                android:textColor="@color/text_primary"
                android:text="[{&quot;Category&quot;:&quot;Books&quot;,&quot;Quantity&quot;:1}]"
                android:gravity="top"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnPushCharged"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Push Charged Event"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/button_bg" />
        </LinearLayout>
        <!-- =================== SAMPLE EVENTS =================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Samples"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnSamplePurchase"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Purchase Event"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/button_bg" />

            <Button
                android:id="@+id/btnSampleCustom3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Custom Event 1"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/button_bg" />

            <Button
                android:id="@+id/btnSampleNativeDisplay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Native Display"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/button_bg" />
        </LinearLayout>

        <!-- =================== NATIVE DISPLAY =================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Native Display"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpNativeDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nativeDataContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvNativeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Native Display units available yet"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="16dp" />

    </LinearLayout>
    </LinearLayout>


</ScrollView>