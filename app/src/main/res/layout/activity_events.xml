<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- =================== PUSH EVENT CARD =================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#11000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊  Push Event"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Name *"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etEventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Viewed"
                android:minHeight="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Properties"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etEventProps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="{&quot;foo&quot;: &quot;xyz&quot;, &quot;lang&quot;: &quot;French&quot;}"
                android:minHeight="80dp"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional JSON object with event properties"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnPushEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Push Event" />
        </LinearLayout>

        <!-- =================== SAMPLE EVENTS =================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Samples"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnSamplePurchase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Purchase" />

            <Button
                android:id="@+id/btnSampleCustom3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Custom 3" />

            <Button
                android:id="@+id/btnSampleNativeDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Native Disp" />
        </LinearLayout>

        <!-- =================== CHARGED EVENT CARD =================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:background="#11000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💳  Charged Event"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSampleCharged"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Load Sample"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Charge Details *"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etChargeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="{&quot;Amount&quot;: 300, &quot;Payment&quot;: &quot;Card&quot;}"
                android:minHeight="80dp"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items Purchased *"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etChargeItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="[{&quot;Category&quot;: &quot;Books&quot;, &quot;Quantity&quot;: 1}]"
                android:minHeight="80dp"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/btnPushCharged"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Push Charged Event" />
        </LinearLayout>

        <!-- =================== NATIVE DISPLAY =================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Native Display"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpNativeDisplay"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nativeDataContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvNativeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Native Display units available yet"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="16dp" />
    </LinearLayout>
</ScrollView>