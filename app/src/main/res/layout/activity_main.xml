<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Console"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="28sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/themeToggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="@drawable/bg_toggle_theme">

                <!-- DARK -->

                <TextView
                    android:id="@+id/tvDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="18sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_secondary"/>

                <!-- LIGHT -->

                <TextView
                    android:id="@+id/tvLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀"
                    android:textSize="18sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= USER CONTEXT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="@color/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER CONTEXT"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="0.05"
                android:paddingBottom="16dp"/>

            <!-- ROW 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- NAME -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USER_NAME"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_bg"
                        android:textColor="@color/text_primary"
                        android:text="Henil Gandhi"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:drawablePadding="8dp"
                        android:drawableTint="#94A3B8"
                        />
                </LinearLayout>

                <!-- IDENTITY -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDENTITY"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etIdentity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_bg"
                        android:textColor="@color/text_primary"
                        android:text="Test123"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:drawableEnd="@android:drawable/ic_lock_idle_lock"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:weightSum="2">

                <!-- EMAIL -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL_ADDRESS"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_bg"
                        android:textColor="@color/text_primary"
                        android:text="henil@clevertap.com"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:drawableEnd="@android:drawable/ic_dialog_email"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_secondary"/>
                </LinearLayout>

                <!-- PHONE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONE_NUMBER"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingBottom="6dp"
                        android:letterSpacing="0.05"/>

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_bg"
                        android:textColor="@color/text_primary"
                        android:text="+919769660756"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:drawableEnd="@android:drawable/ic_menu_call"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= EXEC TRIGGERS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#475569"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● EXEC_TRIGGERS ●"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#475569"/>
        </LinearLayout>

        <!-- GRID OF BUTTONS -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="4"
            android:useDefaultMargins="false">

            <!-- 0x01 OnUserLogin -->
            <LinearLayout
                android:id="@+id/btnOnUserLogin"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x01"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="40sp"
                    android:textColor="@color/text_primary"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OnUserLogin"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- 0x02 ProfilePush -->
            <LinearLayout
                android:id="@+id/btnProfilePush"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x02"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="40sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ProfilePush"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <!-- 0x03 Events -->
            <LinearLayout
                android:id="@+id/btnEvents"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x03"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="52sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Events"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>



            <!-- 0x04 PushTemplates -->
            <LinearLayout
                android:id="@+id/btnPushTemplates"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x04"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textSize="52sp"
                    android:textColor="@color/text_primary"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push Templates"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>


            <!-- 0x05 OpenInbox -->
            <LinearLayout
                android:id="@+id/btnInbox"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x05"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉"
                    android:textSize="52sp"
                    android:textColor="@color/text_primary"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenInbox"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- 0x06 CustomInbox -->
            <LinearLayout
                android:id="@+id/btnCustomInbox"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x06"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥"
                    android:textSize="52sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CustomInbox"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- 0x07 WebView -->
            <LinearLayout
                android:id="@+id/btnWebView"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x07"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="52sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebView"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- 0x08 ActivityLogs -->
            <LinearLayout
                android:id="@+id/btnLogs"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_box_border"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x08"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="52sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ActivityLogs"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </GridLayout>
        <!-- ================= SYSTEM CONSOLE ================= -->


    </LinearLayout>
</ScrollView>